# Copy this file to .env and fill in your real values.
# DO NOT commit your real .env — it is in .gitignore.

# ── Option A: Local PostgreSQL ────────────────────────────────
# (Used as a fallback only if DATABASE_URL is not set.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taif_school
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password_here

# ── Option B: Cloud PostgreSQL (Neon, etc.) ───────────────────
# If set, this takes precedence over the DB_* values above.
# Get it from https://console.neon.tech → your project → Connection Details.
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── App ───────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
